{
  "name": "@cohub/billing",
  "version": "1.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "default": "./dist/interfaces.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./usage-gate": {
      "types": "./dist/usage-gate.d.ts",
      "default": "./dist/usage-gate.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/with-sdk.mjs tsc -p src/talesofai/tsconfig.build.json",
    "test": "node ../../scripts/test/run.mjs --test-isolation=none 'tests/*.test.ts' && node scripts/with-sdk.mjs node ../../scripts/test/run.mjs --test-isolation=none 'tests/talesofai/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/with-sdk.mjs tsc -p src/talesofai/tsconfig.json --noEmit"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
