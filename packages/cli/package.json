{
  "name": "@neta-art/cohub-cli",
  "version": "9.1.0",
  "description": "CLI for Cohub — spaces, sessions, and agent collaboration.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "bin": {
    "cohub": "./bin/cohub.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "verify:sandboxd": "node --import tsx scripts/verify-sandboxd-release.ts",
    "verify:board-kernel": "node --import tsx scripts/verify-board-kernel.ts",
    "prepublishOnly": "pnpm verify:board-kernel && pnpm verify:sandboxd",
    "test": "node ../../scripts/test/run.mjs 'tests/**/*.test.ts'",
    "test:runtime": "node --import tsx --test tests/runtime-*.integration.ts",
    "test:runtime:native": "node --import tsx tests/runtime-native.smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neta-art/cohub": "workspace:*",
    "@neta-art/generation": "^0.1.30",
    "commander": "^15.0.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "pixi.js": "^8.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.8"
  }
}
