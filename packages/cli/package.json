{
  "name": "@neta-art/cohub-cli",
  "version": "10.25.0",
  "description": "CLI for Cohub — spaces, sessions, and agent collaboration.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/netaart/cohub.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/netaart/cohub",
  "bin": {
    "cohub": "./bin/cohub.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node --import tsx scripts/stamp-build.ts",
    "startup": "node scripts/startup.mjs",
    "verify:sandboxd": "node --import tsx scripts/verify-sandboxd-release.ts",
    "verify:rtc": "node --import tsx scripts/verify-rtc-release.ts",
    "prepublishOnly": "pnpm verify:sandboxd && pnpm verify:rtc",
    "test": "node ../../scripts/test/run.mjs 'tests/**/*.test.ts'",
    "test:runtime": "node --import tsx --test tests/runtime-*.integration.ts",
    "test:runtime:native": "node --import tsx tests/runtime-native.smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@neta-art/cohub": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "commander": "^15.0.0",
    "pixi.js": "^8.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.13"
  }
}
