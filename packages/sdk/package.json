      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "import": "./src/http.ts"
    },
    "./websocket": {
      "types": "./src/websocket.ts",
      "import": "./src/websocket.ts"
    },
    "./voice-input": {
      "types": "./src/voice-input.ts",
      "import": "./src/voice-input.ts"
    },
    "./debugger": {
      "types": "./src/debugger.ts",
      "import": "./src/debugger.ts"
    },
    "./space-picker": {
      "types": "./src/space-picker.ts",
      "import": "./src/space-picker.ts"
    },
    "./host-bridge": {
      "types": "./src/host-bridge.ts",
      "import": "./src/host-bridge.ts"
    },
    "./media": {
      "types": "./src/media.ts",
      "import": "./src/media.ts"
    },
    "./board": {
      "types": "./src/board/model/index.ts",
      "import": "./src/board/model/index.ts"
    },
    "./board/editor": {
      "types": "./src/board/editor/index.ts",
      "import": "./src/board/editor/index.ts"
    },
    "./board/replica": {
      "types": "./src/board/replica/index.ts",
      "import": "./src/board/replica/index.ts"
    },
    "./board/player": {
      "types": "./src/board/player/index.ts",
      "import": "./src/board/player/index.ts"
    },
    "./board/render": {
      "types": "./src/board/render/index.ts",
      "import": "./src/board/render/index.ts"
    },
    "./board/stage": {
      "types": "./src/board/stage/index.ts",
      "import": "./src/board/stage/index.ts"
    },
    "./board/export": {
      "types": "./src/board/export/index.ts",
      "import": "./src/board/export/index.ts"
    },
    "./board/export/node": {
      "types": "./src/board/export/node/index.ts",
      "import": "./src/board/export/node/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "perfect-freehand": "1.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cohub/protocol": "workspace:*",
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "catalog:",
    "pixi.js": "^8.20.1",
    "tsdown": "^0.22.14",
    "tsx": "catalog:",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "pixi.js": "^8.19.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    }
  }
}
