{
  "name": "@neta-art/cohub",
  "version": "10.0.0",
  "description": "Cohub SDK for spaces, sessions, boards, and realtime agent collaboration.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "sdk",
    "ai",
    "agent",
    "spaces",
    "realtime",
    "websocket"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./http": {
        "types": "./dist/http.d.ts",
        "import": "./dist/http.js"
      },
      "./websocket": {
        "types": "./dist/websocket.d.ts",
        "import": "./dist/websocket.js"
      },
      "./voice-input": {
        "types": "./dist/voice-input.d.ts",
        "import": "./dist/voice-input.js"
      },
      "./debugger": {
        "types": "./dist/debugger.d.ts",
        "import": "./dist/debugger.js"
      },
      "./space-picker": {
        "types": "./dist/space-picker.d.ts",
        "import": "./dist/space-picker.js"
      },
      "./host-bridge": {
        "types": "./dist/host-bridge.d.ts",
        "import": "./dist/host-bridge.js"
      },
      "./media": {
        "types": "./dist/media.d.ts",
        "import": "./dist/media.js"
      },
      "./board": {
        "types": "./dist/board/model/index.d.ts",
        "import": "./dist/board/model/index.js"
      },
      "./board/editor": {
        "types": "./dist/board/editor/index.d.ts",
        "import": "./dist/board/editor/index.js"
      },
      "./board/replica": {
        "types": "./dist/board/replica/index.d.ts",
