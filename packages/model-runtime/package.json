{
  "name": "@cohub/model-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./image-content": {
      "types": "./dist/image-content.d.ts",
      "default": "./dist/image-content.js"
    },
    "./pi-models-adapter": {
      "types": "./dist/pi-models-adapter.d.ts",
      "default": "./dist/pi-models-adapter.js"
    },
    "./request-profile": {
      "types": "./dist/request-profile/index.d.ts",
      "default": "./dist/request-profile/index.js"
    },
    "./request-profile/claude-code": {
      "types": "./dist/request-profile/claude-code.d.ts",
      "default": "./dist/request-profile/claude-code.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cohub/infra": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@earendil-works/pi-ai": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
