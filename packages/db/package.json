{
  "name": "@cohub/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema-v2": {
      "types": "./dist/schema-v2.d.ts",
      "default": "./dist/schema-v2.js"
    },
    "./schema": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cohub/protocol": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
