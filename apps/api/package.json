{
  "name": "@cohub/api",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "test": "node ../../scripts/test/run.mjs --test-isolation=none 'src/**/*.test.ts' 'tests/**/*.test.ts' && node ../../scripts/test/run.mjs --experimental-test-module-mocks --disable-warning=ExperimentalWarning tests/sandbox-auth.integration.ts tests/storefront.integration.ts tests/app-offline-access.integration.ts tests/decisions.integration.ts tests/space-fs-remote.integration.ts tests/space-fs-stale-stat.integration.ts tests/space-fs-symlink.integration.ts tests/fs-pagination.integration.ts tests/checkpoint-meta-visibility.integration.ts tests/checkpoint-fs-visibility.integration.ts tests/referrals.integration.ts tests/billing-webhooks.integration.ts tests/space-invitations.integration.ts tests/slug-history.integration.ts tests/space-turns.integration.ts tests/runtime-approvals.integration.ts tests/token-usage-credential.integration.ts tests/notifications.integration.ts",
    "test:runtime:archives": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import tsx --test tests/runtime-archives.integration.mjs",
    "test:runtime:native-sync": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import tsx --test tests/native-turns.integration.mjs",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import ./dist/register-otel-esm-hook.js dist/index.js",
    "db:check-drift": "node ../../scripts/db/check-drift.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@cohub/billing": "workspace:*",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/identity": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/media": "workspace:*",
    "@cohub/model-runtime": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-client": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@hono/node-server": "2.1.9",
    "@hono/otel": "^1.3.0",
    "@kubernetes/client-node": "^2.0.2",
    "@neta-art/generation": "0.2.16",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bullmq": "^6.7.8",
    "bullmq-otel": "^2.0.1",
    "cron-parser": "^5.10.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.19",
    "ignore": "^7.0.16",
    "ioredis": "6.0.0",
    "postgres": "^4.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0"
}
