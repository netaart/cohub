AUTH_BASE_URL=http://localhost:3001
# Optional: mirror Checkpoints to a Gitea-compatible Git host.
# Leave both values unset to keep Checkpoints on local Git storage only.
# GITEA_BASE_URL=http://localhost:3000
# GITEA_TOKEN=xxxx
# GITEA_ORG=cohub-spaces
# Legacy managed-account setting; only needed by older integrations.
# GITEA_MANAGED_EMAIL_DOMAIN=cohub.local
APP_ENCRYPTION_KEY=please-change-me-to-a-long-random-secret
WEB_ORIGIN=http://localhost:5173
# Optional: URL of a router-status service that publishes model health,
# observed traffic, and probe history. Leave unset to disable model status.
# ROUTER_STATUS_URL=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cohub
REDIS_URL=redis://localhost:6379
# Sandbox namespace pull Secret, independent of Gitea: unset keeps gitea-registry; empty disables it.
# Sandbox 命名空间中的镜像拉取 Secret，与 Gitea 无关：未设置沿用 gitea-registry，显式留空则不引用。
# SANDBOX_IMAGE_PULL_SECRET=gitea-registry
# For public images / 公开镜像：SANDBOX_IMAGE_PULL_SECRET=
# Optional: Specify kubeconfig path (defaults to ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig
# LiteLLM API key for agent sessions
LITELLM_API_KEY=sk-xxx
# Logto endpoint for token verification
LOGTO_ENDPOINT=http://localhost:3001
# Logto Management API resource indicator (default: https://default.logto.app/api)
# LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api
# Logto M2M app credentials for Management API
# LOGTO_M2M_APP_ID=
# LOGTO_M2M_APP_SECRET=
# Environment: prod or dev (defaults to dev)
# ENV=prod

# R2 user uploads: public chat attachments and private Space upload staging
# USER_UPLOAD_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# USER_UPLOAD_S3_REGION=auto
# USER_UPLOAD_S3_ACCESS_KEY_ID=
# USER_UPLOAD_S3_SECRET_ACCESS_KEY=
# CHAT_ATTACHMENT_S3_BUCKET=cohub-chat-attachments
# CHAT_ATTACHMENT_PUBLIC_BASE_URL=https://uploads.example.com
# SPACE_UPLOAD_S3_BUCKET=cohub-space-uploads

# Optional: hosted Talesofai Billing (leave empty to disable billing)
# TALESOFAI_BILLING_BASE_URL=
# TALESOFAI_BILLING_BUSINESS_KEY=
# TALESOFAI_BILLING_ADMIN_API_KEY=

# Optional: deployment-level Meta provider for Work promotions
# COHUB_META_PIXEL_ID=
# COHUB_META_CAPI_ACCESS_TOKEN=
# COHUB_META_API_VERSION=v21.0
# Trusted proxy header for Meta CAPI client_ip_address (for example: cf-connecting-ip)
# COHUB_META_CLIENT_IP_HEADER=
# Optional Meta Events Manager test code. Remove after testing.
# COHUB_META_TEST_EVENT_CODE=

# Optional: OIDC API resource / audience (defaults to https://api.talesofai)
# AUTH_RESOURCE=https://api.example.com
