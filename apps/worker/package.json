{
  "name": "@cohub/worker",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:system": "tsx watch src/entrances/system-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "node ../../scripts/test/run.mjs 'tests/**/*.test.ts' && node ../../scripts/test/run.mjs --experimental-test-module-mocks --disable-warning=ExperimentalWarning tests/checkpoint-storage.integration.ts tests/create-space.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:system": "node dist/entrances/system-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.1173.0",
    "@cohub/billing": "workspace:*",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/model-runtime": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@kubernetes/client-node": "^2.0.2",
    "@neta-art/generation": "0.2.15",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bullmq": "^6.7.8",
    "bullmq-otel": "^2.0.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "ignore": "^7.0.16",
    "ioredis": "6.0.0",
    "postgres": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
