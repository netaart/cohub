<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Cohub</AssemblyName>
    <RootNamespace>Cohub</RootNamespace>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CohubEnvironment Condition="'$(CohubEnvironment)' == ''">prod</CohubEnvironment>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CohubEnvironment" Value="$(CohubEnvironment)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../windows/Cohub.Core/Cohub.Core.csproj" />
    <Compile Include="../../windows/Cohub/Updates.cs" Link="Updates.cs" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
