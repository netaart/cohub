{
  "name": "@cohub/agent",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-shell-assets.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "node ../../scripts/test/run.mjs --test-isolation=none 'src/tests/**/*.test.ts'",
    "test:runtime": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import tsx --test 'src/tests/runtime-*.integration.ts'",
    "test:runtime:db": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import tsx --test src/tests/runtime-persistence.integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/media": "workspace:*",
    "@cohub/model-runtime": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@cohub/sandbox-client": "workspace:*",
    "@cohub/sandbox-controller": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^6.3.12",
    "bullmq-otel": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "ignore": "^7.0.8",
    "ioredis": "6.0.0",
    "postgres": "^3.4.9",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "tsx": "catalog:",
    "typescript": "^7.0.2"
  }
}
