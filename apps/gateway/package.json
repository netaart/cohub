{
  "name": "@cohub/gateway",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "node ../../scripts/test/run.mjs 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cohub/identity": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/media": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@hono/otel": "^1.1.2",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^6.3.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "hono": "4.13.5",
    "ioredis": "6.0.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.13",
    "typescript": "^7.0.2"
  }
}
