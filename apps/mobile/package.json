{
  "name": "cohub-mobile",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "dependencies": {
    "@logto/rn": "^1.2.0",
    "@neta-art/cohub": "^8.3.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "js-base64": "^3.9.3",
    "lucide-react-native": "^1.37.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "doctor": "expo-doctor",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run release:check && npm run doctor",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "prebuild": "expo prebuild",
    "native:android": "npm run native:android:prepare && npm run native:android:build",
    "native:android:prepare": "npx expo prebuild --platform android --no-install",
    "native:android:build": "node scripts/build-android-debug.mjs",
    "native:android:distribution": "node scripts/build-android-distribution.mjs",
    "native:ios": "npm run native:ios:prepare && npm run native:ios:build",
    "native:ios:prepare": "npx expo prebuild --platform ios --no-install && pod install --project-directory=ios",
    "native:ios:build": "node scripts/build-ios-simulator.mjs",
    "native:android:release": "node scripts/build-android-release.mjs",
    "native:ios:release": "node scripts/build-ios-release.mjs"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}
