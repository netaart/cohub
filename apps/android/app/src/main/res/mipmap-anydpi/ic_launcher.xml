<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. Only the background is declared here: the foreground
  is a vector drawable, so the icon stays crisp at any density without shipping
  per-dpi bitmaps. `ic_launcher_foreground` draws the brand mark.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
