PUBLIC_COHUB_ENV=dev
# Optional hostname template for published standalone Apps, for example {id}.apps.example.com.
PUBLIC_APP_STANDALONE_HOST_TEMPLATE=
PUBLIC_API_ORIGIN=http://localhost:8787
PUBLIC_GATEWAY_ORIGIN=http://localhost:8788
PUBLIC_PREVIEW_ORIGIN=http://localhost:8787
# CDN origin for the Space public files area (`cohub public upload`).
# API-side counterpart: PUBLIC_ASSET_CDN_BASE_URL.
PUBLIC_FILES_ORIGIN=https://public.cohub.live
# Marketplace App ID for this environment.
PUBLIC_MARKETPLACE_APP_ID=00000000-0000-0000-0000-000000000000
# Logto / OIDC overrides (optional; official hosted defaults are baked in)
# PUBLIC_LOGTO_ENDPOINT=https://auth.example.com/
# PUBLIC_LOGTO_APP_ID=...
# PUBLIC_LOGTO_API_RESOURCE=https://api.example.com

# Marketing captures for the landing page (optional; hosted default is baked in)
# PUBLIC_LANDING_MEDIA_BASE=https://cdn.example.com/cohub-landing
