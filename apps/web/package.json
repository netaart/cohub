{
	"name": "web",
	"private": true,
	"version": "0.1.44",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#worker-entry-deps": {
			"types": "./src/entry.worker-deps.d.ts",
			"default": "./.svelte-kit/cloudflare/worker-entry-deps.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/generate-worker-entry-deps.mjs && node ./scripts/check-worker-deps.mjs && node ./scripts/ensure-i18n.mjs --stamp",
		"generate:board-themes": "node --import ./scripts/register-workspace-sources.mjs scripts/board-themes.ts",
		"i18n:compile": "node ./scripts/ensure-i18n.mjs --force",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"test": "node ./scripts/ensure-i18n.mjs && node ../../scripts/test/run.mjs --native-types --test-isolation=none --import ./scripts/register-workspace-sources.mjs 'src/tests/**/*.test.ts' && node ../../scripts/test/run.mjs --native-types --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import ./scripts/register-workspace-sources.mjs src/tests/space-fs-cache.integration.ts src/tests/billing-purchase.integration.ts && COHUB_TEST_ALLOW_NETWORK=1 node ../../scripts/test/run.mjs --native-types src/tests/port-app-proxy.workerd.integration.ts",
		"typecheck": "node ./scripts/ensure-i18n.mjs && node ../../scripts/typecheck-web.mjs",
		"preview": "pnpm build && wrangler dev",
		"preview:prod": "pnpm build && wrangler dev --config wrangler.prod.toml",
		"deploy": "wrangler deploy",
		"deploy:prod": "wrangler deploy --config wrangler.prod.toml",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@cohub/protocol": "workspace:*",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@logto/browser": "^3.1.2",
		"@neta-art/cohub": "workspace:*",
		"@pixi/3d": "0.1.0",
		"@shikijs/langs": "^4.6.0",
		"@shikijs/themes": "^4.6.0",
		"bowser": "^2.15.0",
		"codemirror": "^6.0.2",
		"isomorphic-dompurify": "4.7.0",
		"katex": "^0.19.1",
		"lucide-svelte": "^1.0.1",
		"marked": "18.2.1",
		"pdfjs-dist": "6.5.438",
		"pele": "^1.13.0",
		"pixi.js": "^8.23.0",
		"remend": "^1.4.0",
		"shiki": "^4.6.0",
		"uqr": "^0.1.3",
		"vconsole": "^3.15.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@csstools/css-color-parser": "^4.2.7",
		"@csstools/css-parser-algorithms": "^4.0.2",
		"@csstools/css-tokenizer": "^4.0.2",
		"@inlang/paraglide-js": "3.2.2",
		"@inlang/plugin-message-format": "4.6.0",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"postcss": "^8.5.33",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:svelte-tooling",
		"vite": "catalog:",
		"vite-plugin-pwa": "^2.0.0",
		"wrangler": "catalog:"
	}
}
