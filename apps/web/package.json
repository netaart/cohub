{
	"name": "web",
	"private": true,
	"version": "0.1.44",
	"type": "module",
	"imports": {
		"#worker-entry-deps": {
			"types": "./src/entry.worker-deps.d.ts",
			"default": "./.svelte-kit/cloudflare/worker-entry-deps.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/generate-worker-entry-deps.mjs && node ./scripts/check-worker-deps.mjs && node ./scripts/ensure-i18n.mjs --stamp",
		"generate:board-themes": "node --import ./scripts/register-alias.mjs scripts/board-themes.ts",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"test": "node ./scripts/ensure-i18n.mjs && node ../../scripts/test/run.mjs --native-types --test-isolation=none --import ./scripts/register-alias.mjs 'src/tests/**/*.test.ts' && node ../../scripts/test/run.mjs --native-types --experimental-test-module-mocks --disable-warning=ExperimentalWarning --import ./scripts/register-alias.mjs src/tests/space-fs-cache.integration.ts src/tests/billing-purchase.integration.ts && COHUB_TEST_ALLOW_NETWORK=1 node ../../scripts/test/run.mjs --native-types src/tests/port-app-proxy.workerd.integration.ts",
		"typecheck": "node ./scripts/ensure-i18n.mjs && node ../../scripts/typecheck-web.mjs",
		"preview": "pnpm build && wrangler dev",
		"preview:prod": "pnpm build && wrangler dev --config wrangler.prod.toml",
		"deploy": "wrangler deploy",
		"deploy:prod": "wrangler deploy --config wrangler.prod.toml",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@cohub/protocol": "workspace:*",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.3",
		"@logto/browser": "^3.0.13",
		"@neta-art/cohub": "workspace:*",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"bowser": "^2.14.1",
		"codemirror": "^6.0.2",
		"isomorphic-dompurify": "3.23.0",
		"katex": "^0.19.1",
		"lucide-svelte": "^1.0.1",
		"marked": "18.0.11",
		"pdfjs-dist": "6.3.289",
		"pele": "^1.12.0",
		"pixi.js": "^8.20.1",
		"remend": "^1.3.1",
		"shiki": "^4.4.3",
		"three": "^0.186.1",
		"uqr": "^0.1.3",
		"vconsole": "^3.15.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@csstools/css-color-parser": "^4.2.2",
		"@csstools/css-parser-algorithms": "^4.0.0",
		"@csstools/css-tokenizer": "^4.0.0",
		"@inlang/paraglide-js": "2.24.1",
		"@inlang/plugin-message-format": "4.4.4",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "catalog:",
		"@types/three": "^0.186.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"postcss": "^8.5.26",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"wrangler": "catalog:"
	}
}
