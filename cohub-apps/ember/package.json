{
  "name": "cohub-ember",
  "private": true,
  "version": "0.1.0",
  "description": "A Cohub App where a night camp is a live Board: walk around a fire, talk by proximity, write cards, burn them into stars, and wake a spirit that edits the Board with you.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsgo --incremental --tsconfig ./tsconfig.json",
    "lint": "biome lint src spirit preview public/scripts vite.config.ts",
    "lint:fix": "biome lint --write src spirit preview public/scripts vite.config.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'spirit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lucide/svelte": "^1.55.0",
    "@neta-art/cohub": "^11.1.0",
    "pixi.js": "8.20.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rolldown": "^1.2.13",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
