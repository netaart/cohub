{
  "name": "cohub",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @cohub/api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "pnpm --filter @cohub/agent dev",
    "build": "pnpm -r build",
    "build:agent": "pnpm --filter @cohub/agent... build",
    "build:api": "pnpm --filter @cohub/api... build",
    "build:gateway": "pnpm --filter @cohub/gateway... build",
    "build:worker": "pnpm --filter @cohub/worker... build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "node scripts/test/workspaces.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "lint:biome": "biome lint .",
    "prepare": "husky",
    "ws:client": "tsx scripts/ws-client.ts",
    "rollout:sandbox": "tsx scripts/rollout-sandbox.ts",
    "rollout:sandbox:prod": "tsx scripts/rollout-sandbox-prod.ts",
    "rollout:sandbox:dev": "tsx scripts/rollout-sandbox-dev.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @neta-art/cohub-cli... build && changeset publish",
    "changelog:generate": "tsx scripts/changelog/generate.ts",
    "changelog:render": "tsx scripts/changelog/render.ts",
    "changelog:release": "tsx scripts/changelog/release.ts",
    "billing:configure-first-purchase": "tsx scripts/billing/configure-first-purchase-discounts.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.1",
    "@electric-sql/pglite": "^0.5.8",
    "@napi-rs/canvas": "1.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "zod": "^4.5.4"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "7"
      }
    },
    "overrides": {
      "ioredis": "^6.0.0"
    }
  }
}
